# Custom Airflow image: official image + EdgeGuard worker dependencies (neo4j, pymisp, collectors, etc.).
# Use an explicit **-python3.12** tag: unpinned `apache/airflow:3.3.x` defaults may be 3.10–3.13; EdgeGuard
# requires Python 3.12+ (`pyproject.toml` requires-python). Airflow 3.3 supports Python 3.10–3.14.
# Without this Dockerfile layer, `pip install` inside a running container is lost on recreate.
# Rebuild after dependency changes: `docker compose build airflow`
#
# Upgraded from 2.11.2 → 3.2.0 (April 2026) to clear the flask CVE-2026-27205
# + flask-appbuilder / airflow CVEs that only had fix versions in Airflow 3.x.
# Breaking changes handled in dags/edgeguard_pipeline.py and related files:
#   - Operator imports moved to airflow.providers.standard.operators.*
#   - airflow.models.Variable → airflow.sdk.Variable
#   - airflow.utils.task_group.TaskGroup → airflow.sdk.TaskGroup
# `airflow standalone` migrates the metadata DB on first boot.
#
# Bumped 3.2.0 → 3.3.2 (October 2026) to clear six Trivy CRITICALs the 3.2.0
# base carried and that cannot all be patched from this layer:
#   - apache-airflow CVE-2026-33264 (code execution via unsafe serialized-DAG
#     deserialization) — fixed only in 3.3.0; CVE-2026-42252 — fixed in 3.2.2
#   - PyJWT 2.12.1 CVE-2026-102268 (fix 2.14.0), anyio 4.13.0 CVE-2026-63374
#     (fix 4.14.2), apache-airflow-providers-sftp 5.7.1 CVE-2026-50203 (fix
#     5.8.1), snowflake-connector-python 4.4.0 CVE-2026-15925 (fix 4.7.1)
# The 3.3.2 constraints ship all of those at or above the fixed versions
# (PyJWT 2.14.0, anyio 4.15.1, sftp 6.0.1, snowflake-connector 4.7.3), plus
# providers-fab 3.9.0 → Flask 3.1.3, which also retires the operationally
# accepted Flask CVE-2026-27205. 3.3.x "Significant Changes" list no removed
# or renamed DAG-author APIs (airflow.sdk, TaskGroup, Variable,
# providers.standard are unchanged); the base is still Debian 12 (bookworm),
# so the apt package names below remain valid. Rebuild + `airflow standalone`
# applies the 3.3 metadata migrations on first boot.
#
# tini as PID 1: improves signal forwarding and zombie reaping (helpful on Docker Desktop / constrained VMs).
# docker-compose.yml must NOT use `command: standalone` alone — that would run `tini -- standalone` (invalid).
# Either omit `command` (use CMD below) or set `command: ["airflow", "standalone"]`.
# 2026-10: docker-compose.yml sets a `bash -c` command that starts the collector pool setup in a
# detached background loop and ends in `exec airflow standalone`, so tini still runs standalone.
#
FROM apache/airflow:3.3.2-python3.12

USER root
# PR-B audit fix (Dependency MED-4 + Trivy run): the apache/airflow:3.3.2-python3.12
# base is Debian 12 (bookworm), NOT 13 (trixie) like python:3.12-slim. The
# openssl packages have different names across Debian releases (no
# ``libssl3t64`` / ``openssl-provider-legacy`` in bookworm). Use the generic
# bookworm names ``openssl`` + ``libssl3``.
#
# PR-B audit fix follow-up (Red Team HIGH H2 + Maintainer L1 from the
# comprehensive 7-agent audit): the previous version of this RUN had
# ``(... || true)`` swallowing apt-get failures with the rationale "Trivy
# is the authoritative gate." That's not strictly true — Trivy uses
# ``--ignore-unfixed``, which can hide CVEs whose Debian advisory hasn't
# shipped a ``fixed_version`` matching what's installed. So a network
# blip or a future Debian package rename would silently leave the image
# with the unpatched openssl AND let CI pass.
#
# Tightened: ``--only-upgrade`` returns exit 0 when the package is already
# at latest, so removing ``|| true`` does not break the no-op case. If
# apt-get exits non-zero (package not found, network failure, mirror
# down), the build now fails loudly — operator can re-run or pin a
# specific bookworm point release. TODO(issue #52): drop this entire
# RUN once Debian backports CVE-2026-28390 into the airflow base.
#
# libgnutls30 added 2026-06-11 (PR #125, tracked in issue #124): the base
# image ships 3.7.9-2+deb12u6, CRITICAL-vulnerable to CVE-2026-33845 (DTLS
# DoS) + CVE-2026-42010 (auth bypass via NUL in username); the deb12u7 fix
# is already in the bookworm archive — same upgrade-in-place pattern as
# openssl above.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini \
 && apt-get install -y --no-install-recommends --only-upgrade openssl libssl3 libgnutls30 \
 # 2026-10: Trivy CRITICAL CVE-2026-13221 in perl 5.36.0-7+deb12u3 (image) — fixed in deb12u4,
 # already in the bookworm archive. Same upgrade-in-place pattern as openssl above.
 && apt-get install -y --no-install-recommends --only-upgrade perl-base perl perl-modules-5.36 libperl5.36 \
 && rm -rf /var/lib/apt/lists/*

# Multi-process metrics directory (docker-compose mounts the named volume here). Created and
# owned by the airflow user so the volume inherits writable ownership on first mount.
RUN mkdir -p /opt/airflow/metrics_multiproc && chown -R airflow:root /opt/airflow/metrics_multiproc

USER airflow

COPY requirements-airflow-docker.txt /tmp/requirements-airflow-docker.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow-docker.txt

# 2026-10: Trivy CRITICAL GHSA-6q48-6c7w-9gw2 (certifi bundles emSign root CAs with compromised
# intermediate CA keys) and GHSA-hq85-5cpj-mr62 (uv's bundled CA store trusts an emSign root), both
# in packages of the apache/airflow:3.3.2 base, which has no newer 3.3.x tag. Same upgrade-in-place
# pattern as openssl above:
# - the prek hook runner (with its own uv) serves Airflow development only and is removed;
# - pip 26.2.2 vendors certifi 2026.10.19 (pip 26.2.1 vendored 2026.6.17);
# - certifi and uv in the airflow user's site-packages are upgraded to the fixed releases.
# The requests and PyMISP calls of the tasks verify TLS against this certifi bundle.
RUN uv tool uninstall prek \
 && pip install --no-cache-dir --upgrade "pip>=26.2.2" \
 && pip install --no-cache-dir --upgrade "certifi>=2026.10.19" "uv>=0.13.4"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["airflow", "standalone"]
