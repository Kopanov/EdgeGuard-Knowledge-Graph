# EdgeGuard-KG Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# ── Required ──────────────────────────────────────────────────────────────────

# Neo4j connection
# Default matches docker-compose.yml (x-common-env): Bolt to the neo4j service from other containers.
# Running scripts on the host against a published port: use bolt://localhost:7687 instead.
NEO4J_URI=bolt://neo4j:7687
# HTTP API base for Browser / transactional HTTP (DAG quality curl). Compose defaults to http://neo4j:7474.
# NEO4J_HTTP=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# Database name for every session — multi-database servers only. Unset = the
# server's default database (the single-database default; also right for a
# shared ResilMesh instance unless its operators name the database).
# NEO4J_DATABASE=

# Neo4j container (docker-compose.yml neo4j service only): JVM heap + pagecache + cgroup cap.
# Defaults shipped with this repo are modest (sized for a small dev box). The
# values below are the RECOMMENDED config for a baseline-capable workstation
# (730-day historical window: ~550K nodes and ~2.7M relationships on the hosted
# baseline loaded 2026-10-16); see the memory table in docs/DOCKER_SETUP_GUIDE.md
# for sizing guidance.
#
# Memory math — IMPORTANT:
#   `NEO4J_TX_MEMORY_MAX` sets dbms.memory.transaction.total.max: a CAP on the
#   memory of all running transactions together (heap + off-heap), NOT a
#   separate region and not a per-transaction limit (that would be
#   db.memory.transaction.max, which is not set). Transactions allocating up to
#   the 8g cap pull from the already-committed 12g heap; they do not add to the
#   heap+pagecache budget. So the actual peak RSS during baseline is:
#     12g heap (committed at startup with INITIAL=MAX)
#   +  8g pagecache (committed at startup, off-heap)
#   + ~1g JVM overhead (metaspace, code cache)
#   + ~0.5g Bolt protocol buffers
#   + ~0.5g thread stacks (under heavy concurrency)
#   + ~1-3g transaction off-heap (heavy build_relationships batches)
#   + Lucene mmap (kernel pagecache, NOT counted in process RSS)
#   = ~23-25g typical peak; ~28g extreme.
#   container_limit=32g gives 7g headroom — comfortable, no OOM risk.
#
# HEAP_INITIAL is set EQUAL to HEAP_MAX (12g) per Neo4j Operations Manual
# guidance: "Set the initial heap size and the maximum heap size to the
# same value. This avoids pauses caused by heap resizing." For a long-
# running baseline, eliminating mid-run JVM heap resizing removes a
# category of stop-the-world GC pauses that would otherwise show up as
# query latency spikes during build_relationships.
#
# 2026-04-19 bumps (overnight baseline regression):
#   - tx_memory 4g → 8g (was hitting MemoryLimitExceededException
#     during build_relationships on a 344K-node graph)
#   - container 22g → 32g (was 24g working set on a 22g cgroup —
#     immediate OOM risk; 32g gives ~7g headroom over typical peak)
#   - heap_initial 4g → 12g (= MAX, eliminates GC pauses from resizing)
# NEO4J_HEAP_INITIAL=12g
# NEO4J_HEAP_MAX=12g
# NEO4J_PAGECACHE=8g
# NEO4J_TX_MEMORY_MAX=8g          # Memory CAP of all running transactions together (dbms.memory.transaction.total.max; not additive to heap)
# NEO4J_CONTAINER_MEMORY_LIMIT=32g

# MISP connection
# From Docker Compose (Airflow / API / GraphQL containers): use a hostname that resolves INSIDE the
# container — not host-only names like misp.local unless you also fix DNS. Example when MISP is another
# compose stack on a shared network: https://misp_misp_1:443 (project_service_instance; yours may differ).
MISP_URL=https://your-misp-instance.local
MISP_API_KEY=your-misp-api-key-here
# If MISP_URL uses Docker DNS but Apache SNI / vhost expects another name (common: cert for localhost):
# EDGEGUARD_MISP_HTTP_HOST=localhost
# Self-signed dev MISP (set for every service that calls MISP — see EDGEGUARD_SSL_VERIFY below):
# EDGEGUARD_SSL_VERIFY=false
# MISP→Neo4j sync discovers events via /events/index + filter (restSearch fallback); override substring if needed.
# EDGEGUARD_MISP_EVENT_SEARCH=EdgeGuard

# ── Collector API Keys ─────────────────────────────────────────────────────────
# Leave blank to skip that collector (pipeline degrades gracefully).

OTX_API_KEY=
NVD_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREATFOX_API_KEY=
# Do the providers accept these keys? `python src/edgeguard.py preflight` (or
# `python src/source_key_check.py`) asks each provider once; the baseline DAG does the same in
# its `source_key_check` task, before anything is locked or wiped. A rejected key of an optional
# source is reported and the source is skipped; a rejected NVD key stops the baseline there.
# Cost per check: one VirusTotal lookup (counted in the daily ledger; not sent while a VirusTotal
# collector run is in progress) and one AbuseIPDB `check`.
# Air-gapped installation: disable the requests (configured keys are then reported as unverified).
# EDGEGUARD_SOURCE_KEY_CHECK=true
# Keyed sources a baseline must not start without (otx, nvd, virustotal, threatfox, abuseipdb).
# A listed source with no key, a rejected key, or switched off stops the baseline at its first
# tasks. Empty = no keyed source is mandatory.
# EDGEGUARD_BASELINE_REQUIRED_SOURCES=
# VirusTotal free tier: 4 lookups/min, 500/day. The collector enriches hashes already in MISP
# (GET /files/{sha256}) and keeps a daily ledger in the state directory; every quota message is
# logged with the prefix [VT-QUOTA]. Exhausted budget or HTTP 429 skips the task, never fails it.
# EDGEGUARD_VIRUSTOTAL_DAILY_BUDGET=400
# EDGEGUARD_VIRUSTOTAL_MAX_LOOKUPS_PER_RUN=60   # capped at 200; keep the daily budget >= 6 x this value
# EDGEGUARD_VIRUSTOTAL_CANDIDATE_DAYS=30
# EDGEGUARD_VIRUSTOTAL_BUDGET_PATH=   # default <EDGEGUARD_STATE_DIR or ./state>/virustotal_daily_budget.json
# Docker Compose: slots of the Airflow pool "edgeguard_collectors" that every collector task runs in,
# i.e. how many collectors run at once across all DAGs (default 4). Lower it if MISP workers or the
# airflow container hit their memory limit (HTTP 502 from MISP, SIGKILL); raise it only with headroom.
# Compose creates the pool when the airflow service starts (apply a change with `docker compose up -d airflow`;
# a restart keeps the old value); without Compose create it by hand:
#   airflow pools set edgeguard_collectors 4 "Collector tasks"
# EDGEGUARD_COLLECTOR_POOL_SLOTS=4

# AbuseIPDB blacklist (2026-10): the free plan allows 5 blacklist requests per UTC day. A fetched,
# non-empty blacklist is kept in <EDGEGUARD_STATE_DIR or ./state>/abuseipdb_blacklist_cache.json; a
# run asking for the same parameters (a task retry after a MISP failure, a cleared task, the other
# DAG: with the default settings the daily and the baseline runs both ask for confidenceMinimum 90
# and limit 10000, one cache key) reuses it while it was fetched on the current UTC day and is at
# most this many hours old, and sends no request. A 429 on the blacklist means the day's quota is
# spent: the task fails at once, without the rate-limit backoff (docs/RUNBOOK.md, "AbuseIPDB daily
# blacklist quota"). To force a fresh request, delete the file. Max cache age in hours; 0 disables
# the cache.
# EDGEGUARD_ABUSEIPDB_BLACKLIST_CACHE_HOURS=20

# ── EdgeGuard API ──────────────────────────────────────────────────────────────

# Public API key for the FastAPI REST endpoint (port 8000) and GraphQL endpoint
# (port 4001). Required in production (EDGEGUARD_ENV unset, empty or any value
# other than dev / development / local / staging / test — see EDGEGUARD_ENV
# below), and in non-production when binding to 0.0.0.0 (the docker-compose
# default — necessary for Docker port-forwarding from the host).
#
# CRITICAL: with EDGEGUARD_API_KEY empty (and without item 3 below), the
# api / graphql containers (bound to 0.0.0.0 by compose)
# REFUSE TO START — the startup checks in src/query_api.py (module level,
# ``_IS_PROD`` / ``_BIND_HOST``) and src/graphql_api.py raise ``RuntimeError``. This is
# intentional: an unauthenticated API reachable on the docker network is
# a lateral-movement target.
#
# How to satisfy the check:
#   1. RECOMMENDED — let install.sh auto-generate a 32-byte hex key on first
#      .env creation. Already done if you ran ``./install.sh``.
#   2. MANUAL — run ``openssl rand -hex 32`` (or ``python3 -c 'import secrets;
#      print(secrets.token_hex(32))'``) and paste the value below.
#   3. LAST RESORT (non-production only) — with EDGEGUARD_ENV set to dev,
#      development, local, staging or test, ``EDGEGUARD_ALLOW_UNAUTH=1`` lets
#      the API start without a key on a non-loopback bind. In production
#      (EDGEGUARD_ENV unset, empty or any other value) EDGEGUARD_API_KEY is
#      always required. DO NOT ship this to production.
EDGEGUARD_API_KEY=

# Admin query endpoint (disabled by default).
# Set both variables to enable arbitrary Cypher execution.
EDGEGUARD_ENABLE_ADMIN_QUERY=false
EDGEGUARD_ADMIN_TOKEN=

# REST API bind config (PR-A audit fix: Compose now invokes ``python -m src.query_api``
# so EDGEGUARD_API_HOST actually gates the bind. In non-production
# EDGEGUARD_ENV the A6 bind check of src/query_api.py (``_BIND_HOST``) refuses
# to start unless EDGEGUARD_API_KEY is set OR the host is loopback OR
# EDGEGUARD_ALLOW_UNAUTH=1; in production the key is required in any case.)
# EDGEGUARD_API_HOST=127.0.0.1     # 0.0.0.0 in Compose; safety check fires
# EDGEGUARD_API_PORT=8000
# EDGEGUARD_API_WORKERS=1          # Compose sets =2 for production posture
# EDGEGUARD_API_RELOAD=false       # dev only; forces workers=1

# Deployment env label. FAIL-CLOSED: the API + GraphQL refuse to start
# without EDGEGUARD_API_KEY unless this is one of the recognized non-prod
# labels ``dev`` / ``development`` / ``local`` / ``staging`` / ``test``.
# Anything else — including UNSET, ``stage``, and ``edge`` — is treated as
# prod (see config.is_production_env). Use ``staging``, not ``stage``.
# EDGEGUARD_ENV=dev

# Opt-in escape hatch — start unauthenticated API/GraphQL on a non-loopback
# bind. Takes effect only with a non-production EDGEGUARD_ENV (above); in
# production EDGEGUARD_API_KEY is required whatever this says. Documented for
# completeness; **not recommended for any environment**.
# EDGEGUARD_ALLOW_UNAUTH=1

# REST API DoS defense — max HTTP request body size in bytes. Requests above
# return 413 Payload Too Large.
# EDGEGUARD_MAX_BODY_BYTES=1048576    # 1 MiB

# REST API rate limits (slowapi key-per-IP; docker-compose.yml forwards both to
# the api service; empty = these defaults).
# EDGEGUARD_RATE_LIMIT_READ=60/minute
# EDGEGUARD_RATE_LIMIT_ADMIN=10/minute

# CORS origins allowed to call the API (comma-separated).
# EDGEGUARD_CORS_ORIGINS=http://localhost,http://localhost:3000

# ── Security ───────────────────────────────────────────────────────────────────

# SSL verification for outbound HTTPS (MISP, collectors). Default true — required for production.
# Self-signed / private CA dev MISP: EDGEGUARD_SSL_VERIFY=false
# Alias: if EDGEGUARD_SSL_VERIFY is unset or empty, SSL_VERIFY is read (true|false).
# Not used: SSL_CERT_VERIFY (set EDGEGUARD_SSL_VERIFY instead).
EDGEGUARD_SSL_VERIFY=true

# Defense-in-depth — MISP tag-impersonation check (chip 5e). Without these
# allowlists configured, a MISP user (compromised account, federated peer,
# or internal user) can stamp ``original_source: "nvd"`` on a forged
# attribute and EdgeGuard will treat it as authoritative NVD data —
# corrupting MIN(r.source_reported_first_at) on the SOURCED_FROM edge.
#
# Configure AT LEAST ONE allowlist in production. EdgeGuard verifies the
# parent event's creator org (``Orgc.uuid`` / ``Orgc.name``) against the
# allowlist BEFORE honoring the source-truthful claim. Rejections fire
# the ``edgeguard_source_truthful_creator_rejected_total`` Prometheus
# counter (operator alerts on a non-zero rate; see PROMETHEUS_SETUP.md).
#
# When NEITHER allowlist is set (the default), the check is BYPASSED and
# behavior matches pre-chip-5e — backward-compat for pre-release
# environments. Source: ``src/source_trust.py``.
#
# UUID allowlist (RECOMMENDED — strong defense). Each entry MUST be a
# canonical 8-4-4-4-12 UUID; misconfigured entries get logged at WARNING
# and dropped (a non-UUID string in the env var would otherwise become a
# spoofing vector if a federated peer's Orgc.uuid coincidentally matches).
# EDGEGUARD_TRUSTED_MISP_ORG_UUIDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
#
# Name allowlist (case-insensitive fallback; useful when UUIDs aren't
# exposed by your MISP deployment). Comparison applies Unicode NFKC
# normalization + ``casefold`` — defends against fullwidth Latin
# variants, German ß, Turkish dotless-i. **Does NOT defend against
# Cyrillic / Greek lookalike attacks** (a homoglyph 'е' U+0435 is
# byte-distinct from ASCII 'e' even after NFKC). For deployments
# under active threat, prefer the UUID allowlist.
# Limitation: org names with literal commas are unsupported (split-char
# collision); use the UUID allowlist for any name with punctuation.
# EDGEGUARD_TRUSTED_MISP_ORG_NAMES=EdgeGuard Collectors,Internal Threat Intel

# ── Monitoring ─────────────────────────────────────────────────────────────────

# Grafana admin password (required; no insecure default).
GRAFANA_ADMIN_PASSWORD=changeme

# Prometheus basic-auth password — currently NOT wired to anything in the repo
# (Prometheus basic auth needs a --web.config.file with bcrypt hashes, which is
# not shipped). Placeholder for operators who add their own web-config/proxy.
PROMETHEUS_ADMIN_PASSWORD=

# ── OpenTelemetry ──────────────────────────────────────────────────────────────

# Not wired: src/opentelemetry_config.init_tracing() reads OTEL_EXPORTER_OTLP_ENDPOINT,
# OTEL_EXPORTER_OTLP_INSECURE and EDGEGUARD_DEV_MODE, but no service calls it, so the
# three variables have no effect today (no span is exported or printed).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_INSECURE=false

# ── GraphQL API ───────────────────────────────────────────────────────────────

# Port for the EdgeGuard GraphQL endpoint (mirrors ISIM GraphQL on port 4001).
EDGEGUARD_GRAPHQL_PORT=4001

# PR-A audit fix (Bugbot HIGH on commit 2cdbb1e): the previous
# ``EDGEGUARD_GRAPHQL_HOST=127.0.0.1`` line here was a regression
# trap. install.sh copies .env.example → .env, so docker compose
# would resolve ``${EDGEGUARD_GRAPHQL_HOST:-0.0.0.0}`` to
# 127.0.0.1, which is the container's INTERNAL loopback. Docker's
# port-forwarding bridge can't deliver host traffic to container-
# internal loopback — the GraphQL endpoint becomes silently
# unreachable from the host (the healthcheck inside the container
# still reports healthy, masking the failure).
#
# Same pattern as EDGEGUARD_API_HOST (not listed in .env.example
# either) — operators who genuinely want to bind GraphQL to host
# loopback must use a different mechanism (reverse proxy on the
# host side, or change the compose ``ports:`` mapping). For the
# default ``docker compose up`` flow, leave this UNSET so compose
# falls back to its 0.0.0.0 default and the startup check in
# src/graphql_api.py (module level, ``_IS_PROD`` / ``_BIND_HOST``) gates the
# bind via EDGEGUARD_API_KEY.
# EDGEGUARD_GRAPHQL_HOST=

# Uvicorn worker count (Compose sets =2 for production posture; PR-A audit fix).
# EDGEGUARD_GRAPHQL_WORKERS=1

# Max nesting depth for GraphQL queries (DoS defense).
# EDGEGUARD_GRAPHQL_MAX_DEPTH=8
# Most root fields one GraphQL operation executes, aliases and fragment spreads
# expanded (each one is a Cypher statement), and the expanded selection budget
# checked before validation (fragment-chain DoS defense). docker-compose.yml
# forwards both to the graphql service (2026-10); empty = these defaults.
# EDGEGUARD_GRAPHQL_MAX_ALIASES=15
# EDGEGUARD_GRAPHQL_MAX_SELECTIONS=2000

# Disable the interactive GraphiQL browser explorer in production.
EDGEGUARD_GRAPHQL_PLAYGROUND=false

# ── Airflow ────────────────────────────────────────────────────────────────────
#
# The airflow service image is built from Dockerfile.airflow (edgeguard-airflow:3.3.2-python3.12), which installs
# requirements-airflow-docker.txt — including neo4j and pymisp for MISP→Neo4j DAG tasks. If you only
# `pip install` inside a running container, packages are lost on recreate. Rebuild after clone or dep changes:
#   docker compose build airflow && docker compose up -d airflow
#
# Airflow 3.x requires an explicit JWT secret for the API server (it signs the
# POST /auth/token and execution-API tokens; compose passes it as
# AIRFLOW__API_AUTH__JWT_SECRET, [api_auth] jwt_secret). Without it the API
# server fails to start with 'jwt_secret not set'. Generate once with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# and keep the value stable across restarts so issued tokens remain valid.
# install.sh auto-generates this on first .env creation. Operators who skip
# install.sh must set it manually before ``docker compose up airflow``.
# AIRFLOW_API_AUTH_JWT_SECRET=

# Airflow encrypts connection secrets (passwords, API keys stored in Airflow
# Connections) with a Fernet key. Without it Airflow generates a random key
# at startup and connection secrets become unreadable after restart. Generate
# once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or any 32-byte urlsafe-base64 string). install.sh auto-generates this on
# first .env creation; operators who skip install.sh must set it manually.
# AIRFLOW_FERNET_KEY=

# Airflow connection URI for Neo4j. Not read by EdgeGuard code: the DAG tasks connect with
# NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD; when set, Airflow only registers it as the
# connection neo4j_default.
AIRFLOW_CONN_NEO4J_DEFAULT=

# Docker Compose: memory limit for the airflow container (full MISP→Neo4j sync spikes Python RSS).
# Default is 12g — large MISP events (100K+ attributes) need 8-12GB for PyMISP JSON parsing.
# Lower to 4g only for small test deployments; raise if tasks still get SIGKILL (-9).
# AIRFLOW_MEMORY_LIMIT=12g

# Docker Compose only: metadata database for the Airflow container (internal Postgres).
# Defaults match docker-compose.yml. Airflow metadata uses PostgreSQL (see Apache Airflow DB docs for other backends).
# Use URL-safe passwords (no @ : / # ?) or the connection string in compose will break.
# AIRFLOW_POSTGRES_USER=airflow
# AIRFLOW_POSTGRES_PASSWORD=airflow
# AIRFLOW_POSTGRES_DB=airflow
# Docker memory cap for the airflow_postgres service (PR-A bumped 512m → 2g
# default; Airflow 3.x heartbeat load on a 24h+ baseline overruns 512m).
# AIRFLOW_POSTGRES_MEMORY_LIMIT=2g

# DAG preflight (pass through to Airflow container env): MISP API+DB must be up; workers optional.
# EDGEGUARD_MISP_HEALTH_REQUIRE_WORKERS=true
# EDGEGUARD_SKIP_MISP_PREFLIGHT=true   # emergency only — skips misp_health_check task logic

# MISP→Neo4j sync: max parsed items per Python chunk before Neo4j merge (limits RAM; default 500).
# Lower if Airflow worker is OOM-killed on large backfills (tens of thousands of attributes).
# "0" or "all" (case-insensitive) = single pass — entire sorted list in one chunk (OOM risk; expert/debug).
# EDGEGUARD_NEO4J_SYNC_CHUNK_SIZE=500
# EDGEGUARD_NEO4J_SYNC_CHUNK_SIZE=all
# Relationship definitions per Neo4j UNWIND batch (default 500).
# EDGEGUARD_REL_BATCH_SIZE=500
# Opt-in: run gc.collect() after each Neo4j sync chunk (not recommended in small workers).
# EDGEGUARD_DEBUG_GC=1

# Issue #62 silent-loss gate: minimum fraction of ATTEMPTED MISP pushes
# (success / (success + failed); deduplicated items are not attempts) that must
# succeed for a collector run to count as success. Below the threshold the
# Airflow task fails RED with the rate in the error (the 2026-04-19 baseline
# lost 14.7% of NVD attributes under a green DAG). Default 0.95. Set to 0 to
# disable (legacy any-success-is-success). Every run also logs a grep-able
# COLLECTOR_SUMMARY line with pushed/failed/rate.
# EDGEGUARD_MISP_MIN_SUCCESS_RATE=0.95

# MISP push accounting. After each batch POST the writer reconciles the pushed
# attributes against the attribute list MISP returns for the event; attributes
# that are absent are logged ([UNCONFIRMED]) and counted in the writer stats.
# With this flag they also count as failed pushes and feed the success-rate
# gate above. Enable after a live check shows no spurious unconfirmed
# attributes (MISP normalises some values on save). Default: off.
# EDGEGUARD_MISP_STRICT_PUSH_ACCOUNTING=false

# MISP write throttling — pause between batch POSTs to prevent MISP memory exhaustion
# on large events (e.g. 95K NVD attributes). Increase on memory-constrained MISP hosts.
# NVD incremental runs also pause it after every 50 attribute edits.
# EDGEGUARD_MISP_BATCH_THROTTLE_SEC=5.0
# Pause between fetching consecutive MISP events during sync (default 2.0s).
# EDGEGUARD_MISP_EVENT_FETCH_THROTTLE_SEC=2.0
# Events exceeding this attribute count are deferred to end of sync (small events first).
# Set to 0 to disable. Default 50000.
# EDGEGUARD_MAX_EVENT_ATTRIBUTES=50000
# MISP attribute-push batch size (the adaptive scaling below lowers it on large events).
# Lower this on memory-constrained MISP hosts that answer HTTP 500 on large batches.
# Default 500.
# EDGEGUARD_MISP_PUSH_BATCH_SIZE=500
# Adaptive scaling (MISPWriter.push_items, docs/MISP_TUNING.md): a target event holding at least
# LARGE attributes is pushed in batches of at most 100 with at least 15 s between them, at least
# HUGE attributes in batches of at most 50 with at least 30 s; after BACKOFF_THRESHOLD batches in a
# row that failed after their retries (HTTP 5xx and other transient errors; 2-100) the writer pauses
# BACKOFF_COOLDOWN_SEC seconds (0-3600; 0 = no pause). Out-of-range values fall back to these
# defaults. docker-compose.yml forwards all four to the airflow service (2026-10).
# EDGEGUARD_MISP_LARGE_EVENT_THRESHOLD=50000
# EDGEGUARD_MISP_HUGE_EVENT_THRESHOLD=100000
# EDGEGUARD_MISP_BACKOFF_THRESHOLD=3
# EDGEGUARD_MISP_BACKOFF_COOLDOWN_SEC=300.0
# Seconds to wait between failed-event retry passes — gives MISP time to recover
# from memory pressure / transient 5xx before re-issuing the fetch. Default 15.0.
# EDGEGUARD_MISP_RETRY_COOLDOWN_SEC=15.0

# PR-F6 (Issue #65): parent-DAG liveness check — orphan-process safeguard
# ─────────────────────────────────────────────────────────────────────────────
# When a baseline DAG run is marked failed (e.g., one tier-1 collector fails),
# Airflow does NOT auto-kill in-flight tasks of the same run. Without this
# safeguard, a long-running ``collect_nvd`` subprocess can keep pushing to MISP
# for hours after the DAG was marked dead — the exact failure mode that produced
# Event 19 + 72K-CVE duplication on 2026-04-19. The safeguard polls the Airflow
# REST API between MISP push batches and exits the collector cleanly when the
# parent dag_run is no longer in 'running' or 'queued' state.
#
# Master switch (default: true). Set to false ONLY for direct CLI runs that
# bypass Airflow OR for offline testing where Airflow API isn't reachable.
# EDGEGUARD_PARENT_DAG_LIVENESS_CHECK=true
#
# Minimum seconds between actual API probes (default 60). The callback is
# called every batch (every ~5s due to MISP throttle), but the API is only
# probed once per interval to avoid hammering Airflow with thousands of calls
# per hour. Lower this for faster orphan detection (cost: more API calls);
# raise it to reduce Airflow API load on tight clusters.
# EDGEGUARD_LIVENESS_CHECK_INTERVAL_SEC=60

# Cross-process baseline mutex (src/baseline_lock.py) — a sentinel file held by a running
# baseline: the edgeguard_baseline DAG run (task baseline_acquire_lock; `edgeguard baseline`
# triggers that DAG) or an in-process `python src/run_pipeline.py --baseline`. While another run
# holds it, the collectors of the scheduled DAGs and the sync DAG's run_neo4j_sync,
# build_relationships and run_enrichment_jobs skip.
# Default: <repo root>/checkpoints/baseline_in_progress.lock (the directory above src/,
# independent of EDGEGUARD_BASE_DIR; /opt/airflow/checkpoints in the Airflow container).
# EDGEGUARD_BASELINE_LOCK_PATH=/absolute/path/to/baseline_in_progress.lock
# Max age (seconds) before a stale lock is auto-cleared. Default 172800 (48 h, above the
# baseline DAG's 32 h dagrun_timeout).
# EDGEGUARD_BASELINE_LOCK_MAX_AGE_SEC=172800

# ── Backup-timestamp gate (PR-F2: required before fresh-baseline) ────────────
#
# ``edgeguard fresh-baseline`` (the destructive command — wipes Neo4j + MISP +
# checkpoints) refuses to run unless EDGEGUARD_LAST_BACKUP_AT records a recent
# backup. Since 2026-06 the ``baseline_clean`` DAG task enforces the SAME gate
# for Airflow UI/API triggers with {"fresh_baseline": true} (previously those
# bypassed it) — docker-compose passes this var into the airflow container.
# This protects against the "fresh-baseline failed at step 4 with no
# recovery story" scenario. See docs/BACKUP.md for the full backup procedure.
#
# Format: ISO 8601 with Z suffix (recommended; UTC). Also accepts ISO with
# explicit offset, or unix epoch seconds. Set immediately after taking a
# backup:
#   echo "EDGEGUARD_LAST_BACKUP_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .env
#   docker compose up -d api graphql airflow   # NOT `restart`: restart does not re-read .env
# EDGEGUARD_LAST_BACKUP_AT=

# Default freshness window is 240 hours (10 days). This reflects the
# typical operator cadence — take a backup once per ~10 days, fresh-baseline
# can be re-triggered freely within that window without re-backing-up.
# Tighten for stricter RPO (e.g. EDGEGUARD_BACKUP_MAX_AGE_HOURS=24 for
# production with daily-backup posture); loosen for low-stakes dev.
# Trade-off note: a 240h window means a fresh-baseline triggered on day 10
# with NO interim backup, if it fails, would require restoring to a 10-day-
# old state + losing 10 days of incremental ingest. Consider tightening if
# losing 10 days of work would be unacceptable. See docs/BACKUP.md.
# EDGEGUARD_BACKUP_MAX_AGE_HOURS=240

# Bypass via ``edgeguard fresh-baseline --skip-backup-check`` for dev/test
# only. Logged at WARNING level so the bypass is audit-trail visible.

# IMPORTANT — ResilMesh deployment port conflict:
# ResilMesh runs Temporal workflow orchestration on port 8080 (the same default
# as the Airflow API server). When deploying EdgeGuard alongside a ResilMesh
# instance on the same host, change the API server port to avoid a silent
# collision. Airflow 3.x config key is AIRFLOW__API__PORT; the legacy
# AIRFLOW__WEBSERVER__WEB_SERVER_PORT is kept as a harmless no-op for
# rollback to a 2.11 image.
# AIRFLOW__API__PORT=8082
# AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8082

# ── Docker Compose examples (Airflow container sees different hostnames than your laptop) ──
# Use strong secrets in production — do not copy example passwords.
# From **inside** the Airflow container, Neo4j is the Compose **service** name (see docker-compose.yml):
#   NEO4J_URI=bolt://neo4j:7687
# MISP must be a hostname the Airflow container can open (often the MISP service name or Docker network alias), not host-only localhost:
#   MISP_URL=https://your-misp-service:443
# Example default Docker Compose naming for a project folder `misp`: https://misp_misp_1:443
# If Apache needs Host: localhost for TLS while the URL uses Docker DNS, see docs/MISP_SOURCES.md:
#   EDGEGUARD_MISP_HTTP_HOST=localhost
# Dev MISP with self-signed cert (set on scheduler + workers):
#   EDGEGUARD_SSL_VERIFY=false
# Task heartbeat timeout (long tasks such as NVD or full_neo4j_sync failed for missing heartbeats):
# docker-compose.yml sets on **airflow** (override in .env; Airflow 3 option names since 2026-10 —
# the former SCHEDULER_ZOMBIE_TASK_THRESHOLD / ZOMBIE_DETECTION_INTERVAL names are ignored by
# Airflow 3, and LOCAL_TASK_JOB_HEARTBEAT_SEC is no longer set):
#   AIRFLOW__SCHEDULER__TASK_INSTANCE_HEARTBEAT_TIMEOUT (default 3600; Airflow's own default 300)
#   AIRFLOW__SCHEDULER__TASK_INSTANCE_HEARTBEAT_TIMEOUT_DETECTION_INTERVAL (default 60; Airflow's own 10)
# See docs/HEARTBEAT.md
# AIRFLOW__SCHEDULER__TASK_INSTANCE_HEARTBEAT_TIMEOUT=7200

# ── Airflow REST API (edgeguard dag / preflight / doctor, in-task liveness probe) ──

# Base URL of the Airflow API server. The default works on the host (port
# published by docker-compose) and inside the Airflow container.
# AIRFLOW_WEBSERVER_URL=http://localhost:8082

# API generation: v2 = Airflow 3 (JWT bearer token from POST /auth/token, the
# default for the pinned apache/airflow:3.3.2 image); v1 = Airflow 2 (HTTP Basic).
# AIRFLOW_API_VERSION=v2

# Credentials. `airflow standalone` creates the user `admin` and writes its
# password to <AIRFLOW_HOME>/simple_auth_manager_passwords.json.generated inside
# the container; processes inside the container read that file when
# AIRFLOW_API_PASSWORD is unset. The host CLI needs the values here (copy the
# password from `docker compose exec airflow cat
# /opt/airflow/simple_auth_manager_passwords.json.generated`).
# AIRFLOW_API_USER=admin
# AIRFLOW_API_PASSWORD=

# ── Runtime Paths ──────────────────────────────────────────────────────────────

# Host-side overrides for the CLI only. Inside the Airflow container the
# directories are /opt/airflow/checkpoints and /opt/airflow/state, bind-mounted
# from ./checkpoints and ./state by docker-compose (owned by uid 50000; the
# host CLI reads them, host-side deletes go through `docker compose exec airflow`).
# Override default checkpoint directory (default: <project_root>/checkpoints/).
# Path-traversal guarded — must stay inside the project root or it's reverted.
# EDGEGUARD_CHECKPOINT_DIR=

# Override default state directory (default: <project_root>/state/).
# EDGEGUARD_STATE_DIR=

# MISP -> Neo4j sync schedule (2026-10): edgeguard_neo4j_sync runs every 72 hours and skips a run
# when the last sync started less than 24 hours ago (the baseline's full sync, a forced sync); both
# are fixed in dags/edgeguard_pipeline.py (NEO4J_SYNC_EVERY, NEO4J_SYNC_MIN_GAP) and the Prometheus
# thresholds are derived from them. EDGEGUARD_SYNC_INTERVAL_TOLERANCE_MIN and the Airflow Variable
# NEO4J_SYNC_INTERVAL are no longer read: they set the former 71 h guard of the 3-day cron.

# Incremental MISP → Neo4j sync writes only the attributes whose MISP timestamp
# falls inside the sync window, not every attribute of an event modified in it
# (right after a baseline that difference is the whole baseline). Unchanged
# items of the same OTX pulse still feed the report-scoped links. An edit that
# changes only event-level tags is not picked up incrementally, nor is a Neo4j
# restored from a dump older than MISP repaired; set the NEO4J_FULL_SYNC Airflow
# Variable for both. false = whole-event behaviour.
# Default: true.
# EDGEGUARD_SYNC_ATTRIBUTE_FILTER=true

# Hours the incremental MISP -> Neo4j sync window reaches back before the last
# sync's start time. MISP stamps attribute timestamps itself, so this only covers
# clock skew between the Airflow and MISP hosts and writes still in flight.
# The 1 h default holds because the collectors and the sync use the same MISP
# (one MISP_URL) and the Airflow and MISP hosts keep their clocks synchronised
# (NTP). A sync that reads a MISP filled by MISP-to-MISP synchronisation or
# import keeps the origin's timestamps and needs an overlap above the copy
# delay: an attribute that arrives later than the overlap is never synced, and
# the run still succeeds. A clock difference between the two hosts larger than
# the overlap skips attributes the same way.
# A larger value re-writes more already-synced attributes (a day-long overlap made
# the first sync after a baseline re-write the whole baseline).
# Values from 0 up to 60 s are raised to 60 s (MISP timestamps are whole
# seconds). Non-numeric or negative values, and values above 720, fall back to
# the default.
# Default: 1.
# EDGEGUARD_SYNC_WINDOW_OVERLAP_HOURS=1

# Transaction timeout (seconds) of the pipeline's Neo4j statements (sync reads,
# build_relationships, enrichment, wipe): the Neo4j server aborts a statement that
# runs longer and the task log shows [NEO4J-TIMEOUT]. Relationship batch writes use
# a fixed 600 s. The largest build_relationships query passed 300 s on a 730-day
# graph with the MalwareBazaar and ATT&CK for ICS families. Default: 3600.
# EDGEGUARD_NEO4J_READ_TIMEOUT=3600

# Minimum number of MISP events the MISP → Neo4j sync must find in its fetch
# window. With the default 0 the guard is disabled: a zero-event window is
# logged as a WARNING, recorded in the sync stats and still reported as a
# successful run. Set to N >= 1 to fail the run instead (ERROR, no success
# recorded, run_neo4j_sync goes red and the state file is not stamped) when
# fewer than N events are returned — e.g. 1 where every window is expected to
# contain at least one EdgeGuard event. Default: 0.
# EDGEGUARD_SYNC_MIN_EVENTS=0

# Override project root directory (used by DAGs for path resolution; rarely needed).
# EDGEGUARD_BASE_DIR=

# CORS origins allowed to call the query API (comma-separated).
# The Graph Explorer page (docs/visualization.html) must be served from one of these origins,
# e.g. http://localhost:3000 (docs/GRAPH_EXPLORER.md); append a presenter's exact origin
# (scheme://host:port) rather than a wildcard. A page opened from disk has the origin null.
# The monitoring stack's Grafana also binds 127.0.0.1:3000; while it runs, serve docs/ on
# another port and append that origin, e.g. ...,http://localhost:3001.
EDGEGUARD_CORS_ORIGINS=http://localhost,http://localhost:3000

# ── Alerting (Slack / NATS) ────────────────────────────────────────────────────

# Enable Slack notifications on collector failure (chip 4 from PR #35).
# EDGEGUARD_ENABLE_SLACK_ALERTS=1

# Slack incoming webhook URL. Either var works; AIRFLOW__SLACK__WEBHOOK_URL
# is the Airflow-style alias.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# AIRFLOW__SLACK__WEBHOOK_URL=https://hooks.slack.com/services/...

# NATS server URL — real-time alert publishing for ResilMesh integration.
# NATS_URL=nats://nats:4222

# ── MITRE ATT&CK collector ─────────────────────────────────────────────────────

# Cap on relationship edges per MITRE sync (0 = unlimited).
# (Legacy alias MITRE_MAX_RELATIONSHIPS is still honored.)
# EDGEGUARD_MITRE_MAX_RELATIONSHIPS=0

# Bypass cache on MITRE STIX bundle fetch (debug only — defeats the
# EDGEGUARD_MITRE_CONDITIONAL_GET 304 short-circuit).
# MITRE_FORCE_REFETCH=1

# ── MISP advanced sync (rarely changed) ───────────────────────────────────────

# /events/index page size during sync.
# EDGEGUARD_MISP_PAGE_SIZE=500

# Max pages to fetch per sync run (caps total events; safety against runaway).
# EDGEGUARD_MISP_MAX_PAGES=100

# Max attribute value length before truncation.
# EDGEGUARD_MISP_MAX_ATTR_VALUE_BYTES=4096

# Lock file that serialises the MISP event get-or-create across the processes of one host (fcntl).
# EDGEGUARD_MISP_EVENT_LOCK_PATH=/tmp/edgeguard_misp_get_or_create_event.lock

# Incremental MISP -> Neo4j window of N + 1 days for a CLI sync run, and for the Airflow
# run_neo4j_sync task when the sync state file cannot be read (the task otherwise reads from the
# last sync's start minus EDGEGUARD_SYNC_WINDOW_OVERLAP_HOURS).
# EDGEGUARD_SYNC_INTERVAL_DAYS=3

# Lines of a collector subprocess's output kept for the task log (non-integer or <= 0 = 2000).
# EDGEGUARD_SUBPROCESS_TAIL_LINES=2000

# Operations-only escape hatches (docs/RUNBOOK.md; leave unset in production; docker-compose.yml
# forwards them to the airflow service):
# EDGEGUARD_EARLIEST_IOC_DATE=1995-01-01
# EDGEGUARD_RESPECT_CALIBRATOR=0
# EDGEGUARD_DISABLE_MERGE_COUNTER_INSPECTION=1

# ── Sector / zone keyword scoring (optional) ───────────────────────────────────
# Defaults: 1.5 — single keyword in a CVE description (body weight 1.5) can tag a sector.
# Raise to reduce false positives (e.g. 2.0 requires stronger multi-hit evidence).
# EDGEGUARD_ZONE_DETECT_THRESHOLD=1.5
# EDGEGUARD_ZONE_ITEM_THRESHOLD=1.5

# ── Duplicate avoidance (collectors + MISP) ────────────────────────────────────
# Before push: prefetch existing (type,value) on the target MISP event and skip matches.
# EDGEGUARD_MISP_PREFETCH_EXISTING_ATTRS=true
#
# PR-F7 (Issue #61 quick-fix): also prefetch existing (type,value) ACROSS all
# EdgeGuard MISP events for the same source — catches duplicates that the
# per-event prefetch misses when the same source's data ends up in multiple
# events on different push days. The 2026-04-19 incident measured 72,479
# CVEs duplicated between two NVD events because the runs landed on
# different UTC days. With this enabled, the second run sees "already
# exists in MISP under any source-tagged event" and skips at push time.
#
# Default ON. Disable on huge MISP installs where the cross-event prefetch
# query becomes the slow part of the baseline (~30-40s for 92K NVD attrs).
# The architectural fix is event partitioning by attribute date — see Issue #61.
# EDGEGUARD_MISP_CROSS_EVENT_DEDUP=true
#
# Re-reported indicators (2026-10): an indicator a source reports again that MISP already holds
# for it is not pushed again, but when MISP last wrote the stored copy (its timestamp) more than
# this many days ago, the copy is edited once: last_seen becomes the source's claim when that is
# later than the stored one and otherwise stays as it is; nothing else is sent. MISP stamps the
# copy anew, so the incremental MISP -> Neo4j sync reads it again. Since 2026-10-16 an indicator
# ages from its source's own last-report date (last_seen, capped at the MISP record time; the MISP
# time when the source gives none), so the edit moves its age only when the source's date moved,
# or, for a source without a date, to the time of the edit. Only the indicators a run reports are
# refreshed; since 2026-10 Feodo Tracker and SSL Blacklist report their whole list per run, and the
# AbuseIPDB blacklist at most 10,000 addresses, which AbuseIPDB chooses (their per-run caps below;
# before, the first 200 entries). 0 = no refresh. At most EDGEGUARD_MISP_REFRESH_MAX_PER_RUN edits (0 = no
# cap) and EDGEGUARD_MISP_REFRESH_MAX_SECONDS seconds (0 = no limit) per collector run, the
# longest unwritten first; the refresh also stops after 5 failed edits in a row. The same
# EDGEGUARD_MISP_REFRESH_MAX_SECONDS limit, timed separately, bounds the CISA KEV in-place edits of
# a run (collectors/vulnerability_update.apply_vulnerability_edits), with the same stop after 5
# failed edits in a row; the edits not started are deferred to the next run.
# EDGEGUARD_MISP_REFRESH_LAST_SEEN_DAYS=30
# EDGEGUARD_MISP_REFRESH_MAX_PER_RUN=2000
# EDGEGUARD_MISP_REFRESH_MAX_SECONDS=600
#
# Indicator aging (2026-10-16, src/indicator_aging.py): one rule for every Indicator, whoever
# supplied it; no other label ages. The age counts from the latest report of any source (the
# source's own last-report date capped at the MISP record time). From each tier day the
# confidence is the source's confidence times that tier's factor (never below 0.10); from the
# retire days the indicator is retired (active=false, retired_by=decay), and a newer report brings
# it back. Days strictly ascending, one factor per tier day in (0, 1], retirement above the last
# tier day; a wrong setting stops the sync's indicator writes and the aging job with an error.
# EDGEGUARD_AGING_TIER_DAYS=90,180,365
# EDGEGUARD_AGING_FACTORS=0.85,0.70,0.55
# EDGEGUARD_AGING_RETIRE_DAYS=730
#
# OTX incremental: pulses with modified > cursor (minus overlap); first run uses lookback days.
# EDGEGUARD_OTX_INCREMENTAL_LOOKBACK_DAYS=3
# EDGEGUARD_OTX_INCREMENTAL_OVERLAP_SEC=300
# EDGEGUARD_OTX_INCREMENTAL_MAX_PAGES=25
# EDGEGUARD_OTX_BASELINE_MAX_PAGES=200     # baseline page ceiling (stops earlier after 3 empty pages)
# EDGEGUARD_MISP_DELETE_TIMEOUT_SEC=900    # fresh-baseline wipe: read timeout of one MISP event delete (s)
# Known-exploited CVEs outside the baseline window (2026-10): the whole CISA KEV catalogue (in every
# KEV run, baseline or not; false = the dateAdded window of the baseline length), the NVD records of
# every KEV CVE, and CVE ids fetched by id (comma-separated; empty = none).
# EDGEGUARD_KEV_BASELINE_WHOLE_CATALOGUE=true
# EDGEGUARD_NVD_BASELINE_KEV_SWEEP=true
# EDGEGUARD_NVD_EXTRA_CVE_IDS=
# MITRE: If-None-Match on the STIX bundle (304 → skip re-parse/re-push). Baseline always full fetch.
# EDGEGUARD_MITRE_CONDITIONAL_GET=true

# ── 2026-10 fresh-baseline PR ─────────────────────────────────────────────────
# TLP level stamped as tlp:<level> on every MISP attribute → n.tlp (a source's own
# level, e.g. OTX pulse_tlp, overrides it per item). All current sources are open.
# EDGEGUARD_DEFAULT_TLP=white
# MITRE ATT&CK for ICS in the MITRE collector (techniques T08xx, 12 tactics, groups,
# malware; attack_domain=ics). ICS fetch failure never affects the Enterprise ingest.
# EDGEGUARD_ENABLE_MITRE_ICS=false
# Enabling on an existing graph: a baseline run, or MITRE_FORCE_REFETCH=true for one daily run
# (the daily task skips both bundles while the Enterprise ETag is unchanged).
# MITRE_ICS_ATTACK_URL=https://raw.githubusercontent.com/mitre/cti/master/ics-attack/ics-attack.json
# CISA ICS advisories collector (source id cisa_ics): CVEs with the advisory's
# critical-infrastructure sectors (Energy → energy, Healthcare → healthcare,
# Financial Services → finance). Daily DAG task; disabled = logs and returns.
# EDGEGUARD_ENABLE_CISA_ICS=false
# Enabling on an existing graph: run one additive `edgeguard baseline --days 730` afterwards —
# the daily task only looks back EDGEGUARD_CISA_ICS_INCREMENTAL_DAYS (default 30).
# EDGEGUARD_CISA_ICS_INCREMENTAL_DAYS=30
# FIRST EPSS exploit-likelihood scores onto CVE nodes (post-sync enrichment job, default on; a feed
# outage is logged and skipped). The one source written straight to Neo4j; see docs/DATA_SOURCES.md.
# CISA's SSVC decision points come with the NVD records and need no setting.
# EDGEGUARD_ENABLE_EPSS=true
# EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
# EPSS_MAX_BYTES=67108864
# EPSS_DOWNLOAD_DEADLINE_SEC=300
# MalwareBazaar (abuse.ch) collector (source id malwarebazaar): one sha256 indicator per
# sample from the public recent export (last 48 hours, about 1,000 samples); the family
# label (signature) links the hash to Malware nodes. Daily DAG task and baseline tier 2;
# disabled = the task logs and returns a skipped status. No key is required; a configured
# THREATFOX_API_KEY (the abuse.ch Auth-Key) is sent as Auth-Key. The history builds up over
# daily runs — the full export is not used.
# EDGEGUARD_ENABLE_MALWAREBAZAAR=false
# Per-run cap on samples pushed to MISP: labelled samples (signature other than "n/a") are
# kept before unlabelled ones, then the list is cut here. 0 = no cap. This cap replaces
# EDGEGUARD_INCREMENTAL_LIMIT for this source (one 48-hour export holds about 1,000 samples);
# EDGEGUARD_MAX_ENTRIES still applies when set.
# EDGEGUARD_MALWAREBAZAAR_MAX_PER_RUN=500
# Post-sync merge of duplicate ThreatActor nodes into their canonical actor: a non-MITRE node
# whose name is an alias of exactly one MITRE-sourced actor, or that the canonical threat-actor
# reference resolves to another actor on the graph (false = report candidates only).
# EDGEGUARD_ENABLE_ACTOR_ALIAS_MERGE=true
# Canonical threat-actor reference the merge reads (built by scripts/build_canonical_threat_actors.py).
# Unset or empty = src/reference/canonical_threat_actors.json; a missing or invalid file makes the
# merge fall back to ATT&CK aliases alone, with one warning.
# EDGEGUARD_CANONICAL_THREAT_ACTORS=
# Post-sync merge of Malware nodes named after an ATT&CK software id ("cobalt strike - s0154", the
# MISP galaxy naming OTX uses) into the MITRE Malware node of that id, or, for software without one,
# into the node of the base name (false = report pairs only).
# EDGEGUARD_ENABLE_MALWARE_TWIN_MERGE=true

# ── Feature Flags ──────────────────────────────────────────────────────────────

# Enable Prometheus metrics server (port 8001).
EDGEGUARD_ENABLE_METRICS=false

# Metrics server bind address.
# Bare-metal / host runs: default is 127.0.0.1 (loopback only) — safe for
# shared ResilMesh deployments; set 0.0.0.0 only when Prometheus scrapes from
# a different host.
# Docker compose: the airflow and metrics services set this to 0.0.0.0 INSIDE
# the container. Prometheus reaches the metrics service as metrics:8001 over
# edgeguard_net (2026-10; start the monitoring stack with both compose files,
# make monitoring), and its 127.0.0.1:8001:8001 mapping keeps host access
# loopback-only.
# EDGEGUARD_METRICS_HOST=127.0.0.1
# EDGEGUARD_METRICS_PORT=8001
# PROMETHEUS_MULTIPROC_DIR — set by docker-compose (/opt/airflow/metrics_multiproc). Multi-process
# metrics mode: every Airflow task process writes its values there and the `metrics` service serves
# them. On a bare-metal install set it to a writable directory and run `python -m src.metrics_exporter`.

# Console span exporter of init_tracing() in src/opentelemetry_config.py — not wired (no
# service calls it), no effect today; see "OpenTelemetry" above.
# EDGEGUARD_DEV_MODE=false

# ── Collection limits ─────────────────────────────────────────────────────────
#
# Two separate limits for the two collection modes:
#
#   INCREMENTAL (regular cron runs — 2-3 day window)
#     EDGEGUARD_INCREMENTAL_LIMIT — max items per source per cron run.
#       200  → collect at most 200 items from each source (default, keeps runs fast)
#       500  → larger window if sources produce more data in 2-3 days
#         0  → no item cap (only time-range window applies — use with caution)
#
#   BASELINE (manual/one-time full historical load — DAG: edgeguard_baseline)
#     Airflow UI: Admin → Variables — BASELINE_COLLECTION_LIMIT (0 = unlimited) and BASELINE_DAYS (default 730).
#     Docker: optional env overrides (applied inside get_baseline_config(), after Variables):
#
# Quick 7-day smoke test (then remove or comment and restart airflow):
#   EDGEGUARD_BASELINE_DAYS=7
#   EDGEGUARD_BASELINE_COLLECTION_LIMIT=1000
#
# See docs/BASELINE_SMOKE_TEST.md
#
# BASELINE_COLLECTION_LIMIT=0
#
#   EDGEGUARD_MAX_ENTRIES — hard global override for all runs.
#     When set to a non-zero value, overrides INCREMENTAL_LIMIT for every source.
#     Leave at 0 (default) to use the incremental/baseline limits above.
#
#   Docker Compose (2026-10 note): docker-compose.yml does not forward EDGEGUARD_INCREMENTAL_LIMIT
#   or EDGEGUARD_MAX_ENTRIES, and src/config.py does not read this file, so on that deployment the
#   two lines below do not reach the containers and the code defaults apply (200, no override).
#
EDGEGUARD_INCREMENTAL_LIMIT=200
# EDGEGUARD_MAX_ENTRIES=0
#
#   NVD (2026-10) does not use EDGEGUARD_INCREMENTAL_LIMIT: each run reads every CVE modified since
#   its stored cursor, adds the new CVEs and edits the MISP copy of CVEs NVD changed.
#     EDGEGUARD_NVD_MAX_PER_RUN — MISP writes per run (additions + edits); the next run continues.
#     EDGEGUARD_NVD_INCREMENTAL_DAYS — how far back a run reads when no cursor is stored (after a wipe).
#     EDGEGUARD_NVD_CURSOR_OVERLAP_SEC — a run starts reading this much before the cursor (at least 60).
#     EDGEGUARD_NVD_UPDATE_EXISTING — false = add new CVEs only, never edit stored ones.
# EDGEGUARD_NVD_MAX_PER_RUN=5000
# EDGEGUARD_NVD_INCREMENTAL_DAYS=14
# EDGEGUARD_NVD_CURSOR_OVERLAP_SEC=3600
# EDGEGUARD_NVD_UPDATE_EXISTING=true
#
#   CISA KEV (2026-10) does not use EDGEGUARD_INCREMENTAL_LIMIT: every run (every 4 hours, and the
#   baseline) compares the whole catalogue with the stored MISP copies, adds the CVEs MISP lacks and
#   edits the copies of entries CISA revised (ransomware use, due date, description, ...).
#   EDGEGUARD_CISA_INCREMENTAL_DAYS is retired.
#     EDGEGUARD_KEV_MAX_EDITS_PER_RUN — stored copies edited per run; the rest follow on the next run.
#     EDGEGUARD_KEV_UPDATE_EXISTING — false = add new entries only, never edit stored ones.
# EDGEGUARD_KEV_MAX_EDITS_PER_RUN=500
# EDGEGUARD_KEV_UPDATE_EXISTING=true
#
#   ThreatFox and URLhaus (2026-10) do not use EDGEGUARD_INCREMENTAL_LIMIT either: each daily run
#   reads the feed's whole window (ThreatFox: the IOCs of the last 7 days, about 7,400; URLhaus
#   csv_recent: the URLs of the last 30 days, about 34,000) and has a cap sized to it. A run that
#   reaches the cap keeps the newest entries and logs a warning; entries MISP already holds are
#   not pushed again. 0 = no cap; EDGEGUARD_MAX_ENTRIES still applies when set.
# EDGEGUARD_THREATFOX_MAX_PER_RUN=10000
# EDGEGUARD_URLHAUS_MAX_PER_RUN=50000
#
#   Feodo Tracker, SSL Blacklist and AbuseIPDB (2026-10) do not use EDGEGUARD_INCREMENTAL_LIMIT
#   either. Feodo Tracker and SSL Blacklist read the whole list the source publishes (Feodo
#   Tracker: the servers active in the last 30 days, the complete history on a baseline, 7,607
#   servers on 2026-10-12; SSL Blacklist: about 11,000 certificates) and have a cap sized to it, so
#   every entry of the list a run reads is reported again and its stored copy refreshed. A run whose
#   list is longer keeps the newest entries (Feodo: last_online; SSL Blacklist: Listingdate) and
#   logs a warning. AbuseIPDB makes at most one blacklist request per run, as before, and none when
#   the run reuses the answer fetched earlier on the same UTC day
#   (EDGEGUARD_ABUSEIPDB_BLACKLIST_CACHE_HOURS above): the cap is that request's limit, at most
#   10,000 (the most one request returns on the free plan); a larger value has no effect. AbuseIPDB
#   chooses which addresses fill the answer, so a listed address outside it is not reported again.
#   0 = no cap (AbuseIPDB: 10,000); EDGEGUARD_MAX_ENTRIES still applies when set.
# EDGEGUARD_FEODO_MAX_PER_RUN=15000
# EDGEGUARD_SSLBL_MAX_PER_RUN=20000
# EDGEGUARD_ABUSEIPDB_MAX_PER_RUN=10000
#
# Optional: limit which collectors run (Airflow + run_pipeline Step 2).
# Comma-separated canonical names; unset = all enabled.
# Use "none" or "-" alone to disable all external collectors (tasks skip; DAG continues).
# Canonical names: otx, nvd, cisa, cisa_ics, mitre, virustotal, virustotal_enrich, abuseipdb,
#   threatfox, urlhaus, feodo, sslbl
#   malwarebazaar (2026-10, flag-guarded by EDGEGUARD_ENABLE_MALWAREBAZAAR)
# EDGEGUARD_COLLECT_SOURCES=otx,nvd,cisa
# EDGEGUARD_COLLECT_SOURCES=
