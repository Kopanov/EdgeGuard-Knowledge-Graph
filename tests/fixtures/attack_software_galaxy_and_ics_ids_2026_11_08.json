    {
     "source_name": "Maroochy - MITRE - 200808",
     "description": "Marshall Abrams. (2008, July 23). Malicious Control System Cyber Security Attack Case Study– Maroochy Water Services, Australia. Retrieved March 27, 2018.",
     "url": "https://www.mitre.org/sites/default/files/pdf/08%201145.pdf"
    }
   ],
