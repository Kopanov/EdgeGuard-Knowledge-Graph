   "pulse": {
    "id": "6acf8607ba5b3757d207eb86",
    "name": "Fake Calendly \"Meta Careers\" pages steal Facebook and Google logins",
    "description": "A wave of fraudulent websites mimicking Calendly booking pages for Meta job interviews has been identified, targeting job seekers to steal credentials. Victims select interview time slots, provide personal information, and complete fake CAPTCHA verifications before being prompted to log into Facebook and Google accounts. The sophisticated phishing kit captures login credentials and bypasses two-factor authentication by relaying authentication codes in real-time to attackers. The pages use convincing replicas of legitimate login screens with fake address bars displaying authentic URLs. Eleven domains following similar naming patterns have been identified, utilizing generic recruiting-related terms. The collection infrastructure operates through Amazon API Gateway in Singapore, with code comments in Vietnamese suggesting the operation's possible origins.",
    "author_name": "AlienVault",
